{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    // Reports only: CI runs `knip --no-exit-code` (#24), and each finding is
    // looked at before anything is removed.
    "workspaces": {
        ".": {
            "entry": ["scripts/**/*.{js,mjs}", "webpack.base.config.js"],
            // webpack picks up assert and buffer for dependencies that require
            // them in the browser bundles (build:web); removing them changes
            // the bundle (#163). The SDK itself uses neither (#228).
            "ignoreDependencies": ["assert", "buffer"],
        },
        "packages/*": {
            // Type tests (test/types/*.types.ts) are compiled by test:types,
            // not run by Jest.
            "entry": ["test/**/*.{test,types}.ts"],
            "project": ["src/**/*.ts", "test/**/*.ts"],
            "webpack": {
                "config": ["webpack.config.js", "webpack.analyze.js"],
            },
        },
    },
}
