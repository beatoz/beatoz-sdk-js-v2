{
  "name": "beatoz-sdk-js",
  "version": "1.0.1",
  "description": "Javascript SDK for BEATOZ",
  "private": true,
  "keywords": [
    "beatoz",
    "sdk",
    "blockchain",
    "dapp"
  ],
  "homepage": "https://github.com/beatoz/beatoz-sdk-js-v2",
  "bugs": {
    "url": "https://github.com/beatoz/beatoz-sdk-js-v2",
    "email": "dev@beatoz.io"
  },
  "author": {
    "name": "BEATOZ Team",
    "email": "dev@beatoz.io",
    "url": "https://github.com/beatoz"
  },
  "license": "Apache-2.0",
  "workspaces": {
    "packages": [
      "packages/*",
      "tools/*"
    ]
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=8.19.0"
  },
  "scripts": {
    "version": "yarn build && git add packages/*/src/version.ts",
    "prebuild": "yarn clean",
    "build": "lerna run build --stream",
    "build:types": "lerna run build:types --stream",
    "build:esm": "lerna run build:esm --stream",
    "build:web": "lerna run build:web --stream",
    "clean": "lerna run clean --stream --parallel",
    "lint": "lerna run lint --stream --parallel",
    "lint:fix": "lerna run lint:fix --stream --parallel",
    "format": "lerna run format --stream --parallel && prettier --write ./scripts/**/*.ts",
    "test": "lerna run test --stream --parallel",
    "test:silent": "lerna run test:silent --stream --parallel",
    "node:start": "node scripts/testnode.mjs start",
    "node:stop": "node scripts/testnode.mjs stop",
    "node:env": "node scripts/testnode.mjs env",
    "node:start:reward": "node scripts/testnode.mjs start reward",
    "node:stop:reward": "node scripts/testnode.mjs stop reward",
    "node:env:reward": "node scripts/testnode.mjs env reward",
    "test:integration": "lerna run test:integration --stream",
    "test:reward": "lerna run test:reward --stream",
    "dev:example": "ts-node -P tsconfig.base.json --require tsconfig-paths/register examples/explorer/scanner.js"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/plugin-transform-runtime": "^7.19.6",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@eslint/js": "10.0.1",
    "@openzeppelin/contracts": "^4.7.1",
    "@types/jest": "^28.1.6",
    "@types/node": "22.20.2",
    "assert": "^2.0.0",
    "babel-jest": "28.1.3",
    "babel-preset-env": "^1.7.0",
    "babel-preset-react": "^6.24.1",
    "babel-preset-stage-0": "^6.24.1",
    "babelify": "^10.0.0",
    "browserify": "^17.0.0",
    "buffer": "^6.0.3",
    "bufferutil": "^4.0.6",
    "child_process": "^1.0.2",
    "clean-webpack-plugin": "^4.0.0",
    "constants-browserify": "^1.0.0",
    "crypto-browserify": "^3.12.0",
    "declaration-bundler-webpack-plugin": "^1.0.3",
    "dotenv": "^18.0.5",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-license-header": "0.9.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unicorn": "74.0.0",
    "fancy-log": "^2.0.0",
    "globals": "^17.12.0",
    "gulp": "^4.0.2",
    "gulp-clean": "^0.4.0",
    "gulp-rename": "^2.0.0",
    "gulp-typescript": "^6.0.0-alpha.1",
    "gulp-uglify": "^3.0.2",
    "http-browserify": "^1.7.0",
    "https-browserify": "^1.0.0",
    "husky": "^8.0.1",
    "jest": "^28.1.3",
    "jest-extended": "^3.0.1",
    "lerna": "^6.6.2",
    "lint-staged": "^13.0.3",
    "merge2": "^1.4.1",
    "npm-auth-to-token": "^1.0.0",
    "os": "^0.1.2",
    "prettier": "^3.0.0",
    "prettier-plugin-solidity": "1.4.1",
    "process": "^0.11.10",
    "solc": "^0.8.15",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsify": "^5.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "utf-8-validate": "^5.0.9",
    "vinyl-buffer": "^1.0.1",
    "vinyl-source-stream": "^2.0.0",
    "webpack": "5.99.9",
    "webpack-cli": "^4.10.0",
    "wscat": "^5.2.0"
  },
  "packageManager": "yarn@1.22.15",
  "resolutions": {
    "@types/minimatch": "3.0.5"
  },
  "dependencies": {
    "constants-browserify": "^1.0.0",
    "crypto-browserify": "^3.12.0",
    "json-rpc-2.0": "^1.6.0",
    "path-browserify": "^1.0.1",
    "webpack-bundle-analyzer": "4.9.1"
  }
}
