{
    "name": "@beatoz/web3-accounts",
    "version": "1.6.5",
    "main": "./lib/esm/index.js",
    "types": "./lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./package.json": "./package.json"
    },
    "license": "Apache-2.0",
    "keywords": [
        "beatoz",
        "sdk",
        "blockchain",
        "dapp"
    ],
    "homepage": "https://github.com/beatoz/beatoz-sdk-js-v2",
    "author": {
        "name": "BEATOZ Team",
        "email": "dev@beatoz.io",
        "url": "https://github.com/beatoz"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "files": [
        "lib/**/*",
        "src/**/*",
        "CHANGELOG.md",
        "!**/*.tsbuildinfo"
    ],
    "scripts": {
        "clean": "rimraf dist && rimraf lib",
        "prebuild": "yarn clean",
        "build": "yarn version:output && yarn build:esm && yarn build:types",
        "version:output": "[ -z $npm_package_version ] && rm ./src/version.ts || echo \"/* eslint-disable license-header/header */ export const Web3PkgInfo = { version: '$npm_package_version' };\" > ./src/version.ts",
        "build:esm": "tsc --build tsconfig.json && echo '{\"type\": \"module\"}' > ./lib/esm/package.json",
        "build:types": "tsc --build tsconfig.types.json && echo '{\"type\": \"module\"}' > ./lib/types/package.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write '**/*'",
        "test": "jest --config=./test/unit/jest.config.js",
        "test:silent": "jest --silent --config=./test/unit/jest.config.js"
    },
    "devDependencies": {
        "@bufbuild/buf": "^1.73.0",
        "@types/bn.js": "^5.1.1",
        "@types/secp256k1": "^4.0.3",
        "ts-proto": "^1.137.0"
    },
    "dependencies": {
        "@beatoz/web3-types": "^1.6.5",
        "@beatoz/web3-utils": "^1.6.5",
        "bn.js": "^5.2.1",
        "ethereum-cryptography": "2.1.2",
        "ethereumjs-util": "^6.1.0",
        "long": "5.2.3",
        "protobufjs": "^7.6.6",
        "secp256k1": "^4.0.2"
    },
    "peerDependencies": {
        "typescript": ">=5.7"
    },
    "peerDependenciesMeta": {
        "typescript": {
            "optional": true
        }
    }
}
